{# Custom template: attachment click → choose Preview or Download #}
{% if field.value is empty %}
    <span class="badge badge-secondary">无附件</span>
{% else %}
    <ul class="list-unstyled mb-0">
        {% for file in field.value %}
            <li class="mb-2">
                <a
                    href="javascript:void(0)"
                    class="text-decoration-none js-attachment-file-open"
                    role="button"
                    data-file-name="{{ (file.originalName ?? file.fileName ?? '附件')|e('html_attr') }}"
                    data-download-url="{{ path('admin_file_download', {fileId: file.id}) }}"
                    data-modal-url="{{ path('admin_file_modal_preview', {fileId: file.id}) }}"
                >
                    <i class="fa fa-paperclip me-1"></i>
                    {{ file.originalName }}
                    <small class="text-muted">({{ file.fileSizeFormatted }})</small>
                </a>
                {% if file.categoryLabel %}
                    <br><small class="text-muted">{{ file.categoryLabel }}</small>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
